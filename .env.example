# Copy to .env.local and fill in real values. Never commit .env.local.

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- LLM provider (existing brain) -----
OPENROUTER_API_KEY=your-openrouter-key

# ----- Anam (photoreal avatar interview) -----
# Server-only. Get one at https://anam.ai (Dashboard -> API Keys).
# Used by /api/anam-session-token to mint short-lived session JWTs for the
# browser. NEVER exposed to the client.
ANAM_API_KEY=your-anam-api-key

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
